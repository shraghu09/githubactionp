name : 01 ci workflows
on:
 workflow_dispatch:
jobs:
 flask-ci-job:
   runs-on: ubuntu-latest

   steps:
     - name: checkout repository
       uses: actions/checkout@v6

     - name: build a docker image
       run: docker build -t githubactionp-flask-app:v1.0.0 .

     - name: run container
       run: docker run -d -p 5000:5000 --name githubactionp-flask-container githubactionp-flask-app:v1.0.0  

     - name: test the flask application
       run: |
         sleep 5
         curl -f http://localhost:5000




